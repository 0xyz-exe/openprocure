# Environment Configuration Template
PROJECT_NAME="OpenProcure"
VERSION="1.0.0"

# Application Security
SECRET_KEY="replace_with_a_secure_random_secret_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Persistence
# For standalone zero-dependency local development (default):
DATABASE_URL="sqlite:///./openprocure.db"
# For production PostgreSQL container:
# DATABASE_URL="postgresql://openprocure:openprocure_secret_pass@localhost:5432/openprocure"

# Ports
API_PORT=8000
WEB_PORT=5180
